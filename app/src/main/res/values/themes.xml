<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.YoloHomes" parent="android:Theme.Material.Light.NoActionBar" />

    <style name="Theme.YoloHomes.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/black</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.YoloHomes</item>
    </style>

    <!--
        General-purpose AppCompat theme used to host third-party SDK activities
        that extend AppCompatActivity. Theme.YoloHomes parents from
        android:Theme.Material — not an AppCompat descendant — so Firebase App
        Distribution's update/install/sign-in activities crash inheriting it
        ("You need to use a Theme.AppCompat theme (or descendant) with this
        activity."). Applied via tools:replace="android:theme" on those SDK
        activity declarations in AndroidManifest.xml.
    -->
    <style name="Theme.YoloHomes.AppCompat" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="colorPrimary">@color/brand_primary</item>
        <item name="colorPrimaryDark">@color/brand_primary</item>
        <item name="colorAccent">@color/brand_primary</item>
    </style>
</resources>
