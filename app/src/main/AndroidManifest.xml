<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:name=".YoloHomesApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.YoloHomes"
        tools:targetApi="31">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.YoloHomes.Splash">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!--
            Firebase App Distribution SDK ships AppCompatActivity subclasses
            (InstallActivity, etc.) that crash when they inherit our root
            Theme.YoloHomes (a framework android:Theme.Material, not an
            AppCompat descendant). Override the theme on each one via
            tools:replace so AppCompatDelegate.onPostCreate finds the
            colorPrimary / colorAccent attributes it expects. tools:node="merge"
            lets us add android:theme without redeclaring the activity's
            label / exported flags (the SDK's manifest entry stays intact).
        -->
        <activity
            android:name="com.google.firebase.appdistribution.impl.InstallActivity"
            android:theme="@style/Theme.YoloHomes.AppCompat"
            tools:node="merge"
            tools:replace="android:theme" />
        <activity
            android:name="com.google.firebase.appdistribution.impl.TaskCancelAndUpdateDialogActivity"
            android:theme="@style/Theme.YoloHomes.AppCompat"
            tools:node="merge"
            tools:replace="android:theme" />
        <activity
            android:name="com.google.firebase.appdistribution.impl.SignInResultActivity"
            android:theme="@style/Theme.YoloHomes.AppCompat"
            tools:node="merge"
            tools:replace="android:theme" />
    </application>

</manifest>
